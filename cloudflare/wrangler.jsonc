{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cc-mama-travel-radar-scheduler",
  "main": "scheduler.mjs",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "triggers": { "crons": ["0 0 * * *"] },
  "observability": { "enabled": true },
  "send_metrics": false
}
